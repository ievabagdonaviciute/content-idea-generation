APP_ENV=development
DATABASE_URL=postgresql+asyncpg://kadro:kadro@localhost:5432/kadro
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

DEFAULT_TIKTOK_USERNAME=ieva.bagdonaviciute
DEFAULT_OUTPUT_LANGUAGE=lt

# The only Notion-related secret. The target page/database are hardcoded in
# apps/api/app/core/personal_config.py and auto-provisioned on first sync -- see
# docs/NOTION_SETUP.md. Do not add a database ID here; none is needed.
NOTION_TOKEN=
NOTION_SYNC_ENABLED=false
NOTION_SYNC_INTERVAL_MINUTES=30

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_EMBEDDING_MODEL=

MAX_MEDIA_SIZE_MB=200
MEDIA_STORAGE_PATH=./data/media
