APP_ENV=development
DATABASE_URL=postgresql+asyncpg://kadro:kadro@localhost:5432/kadro
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

DEFAULT_TIKTOK_USERNAME=ieva.bagdonaviciute
DEFAULT_OUTPUT_LANGUAGE=lt

# The only Notion-related secret. The target page/database are hardcoded in
# apps/api/app/core/personal_config.py and auto-provisioned on first sync -- see
# docs/NOTION_SETUP.md. Do not add a database ID here; none is needed.
NOTION_TOKEN=
NOTION_SYNC_ENABLED=false
NOTION_SYNC_INTERVAL_MINUTES=30

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# AI_API_KEY is a secret -- leave blank here. Without it, the app uses
# deterministic fake providers (see app/ai/factory.py). The fields below are
# NOT secrets but must not be left blank if AI_API_KEY is set: pydantic-settings
# treats an empty value in .env as an explicit "" override, not "unset", so a
# blank line here would replace the code's working defaults with "".
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=whisper-1
AI_EMBEDDING_MODEL=text-embedding-3-small

MAX_MEDIA_SIZE_MB=200
MEDIA_STORAGE_PATH=./data/media

# Optional -- image/meme sourcing for idea detail pages. See
# docs/MEDIA_SOURCING.md. Without these, a fake provider is used.
PEXELS_API_KEY=
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
